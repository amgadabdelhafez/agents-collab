{
  "name": "agents-collab-loop-fork",
  "version": "1.0.32",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/amgadabdelhafez/agents-collab.git",
    "directory": "loop-fork"
  },
  "scripts": {
    "build": "bun build --compile --outfile loop src/cli.ts",
    "install:global": "bun run build && bun run src/install.ts",
    "test:ci": "for file in $(find tests -name '*.test.ts' | sort); do bun test \"$file\" || exit 1; done",
    "release:patch": "npm version patch && git push --follow-tags",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "bin": {
    "claude-loop": "./src/claude-loop.ts",
    "codex-loop": "./src/codex-loop.ts",
    "cursor-loop": "./src/cursor-loop.ts",
    "gemini-loop": "./src/gemini-loop.ts",
    "loop": "./src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^25.5.0",
    "bun-types": "^1.3.11",
    "typescript": "^5.9.3",
    "ultracite": "^7.3.2"
  }
}
