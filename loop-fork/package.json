{
  "name": "agents-collab-loop-fork",
  "version": "1.0.38",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/amgadabdelhafez/agents-collab.git",
    "directory": "loop-fork"
  },
  "scripts": {
    "build": "bun build --compile --outfile loop src/cli.ts",
    "install:global": "bun run build && bun run src/install.ts",
    "test:file": "LOOP_TEST_CERTIFICATION_MODE=single-file bun test",
    "test:ci": "for file in $(find tests -name '*.test.ts' | sort); do LOOP_TEST_CERTIFICATION_MODE=single-file bun test \"$file\" || exit 1; done",
    "release:patch": "npm version patch && git push --follow-tags",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "bin": {
    "claude-loop": "./src/claude-loop.ts",
    "codex-loop": "./src/codex-loop.ts",
    "loop": "./src/cli.ts",
    "oss-loop": "./src/oss-loop.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^25.5.0",
    "bun-types": "^1.3.11",
    "typescript": "^5.9.3",
    "ultracite": "^7.3.2"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "caveman-installer": "github:JuliusBrussee/caveman#0d95a81d35a9f2d123a5e9430d1cfc43d55f1bb0",
    "proper-lockfile": "4.1.2"
  }
}
