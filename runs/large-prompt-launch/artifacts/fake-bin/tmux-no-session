#!/bin/sh
case "${LOOP_TMUX_SOCKET:-}" in
  /*) ;;
  *) exit 64 ;;
esac
if [ "$#" -eq 1 ] && [ "${1:-}" = "-V" ]; then
  printf '%s\n' 'tmux 3.5a'
  exit 0
fi
if [ "${1:-}" != "-S" ] || [ "${2:-}" != "${LOOP_TMUX_SOCKET}" ]; then
  exit 64
fi
shift 2
if [ "${1:-}" = "has-session" ]; then
  echo "can't find session: smoke-missing-workspace" >&2
  exit 1
fi
if [ "${1:-}" = "new-session" ]; then
  echo "smoke fixture refused workspace creation" >&2
  exit 1
fi
exit 0
